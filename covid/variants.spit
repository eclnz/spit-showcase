# SARS-CoV-2 variants: trim each sample's paired reads, align them to the
# reference, call variants per sample, and merge the calls into one table.

source reference : Fasta .fasta
source r1 : Fastq .fastq.gz [sample] @check(fastq_ok)
source r2 : Fastq .fastq.gz [sample] @check(fastq_ok)

default entities: {@key}={@value} separated "_"
default path: out/{@stage}/{@product}[/{@entities}]

check nonempty: test -s {@path}
check bam_ok: samtools quickcheck {@path}
# A gzipped FASTQ whose first record starts with `@`: `test -s` passes a gzip of nothing.
check fastq_ok: sh -c 'zcat "$1" | head -n 1 | grep -q "^@"' sh {@path}

stage reference:
    # bwa writes its index under a prefix, and bwa mem reads it by the same
    # prefix: the index is one folder, with the prefix `genome` inside it.
    operation bwa_index(reference: Fasta) -> BwaIndex /
    command bwa_index: bwa index -p {@output}/genome {reference}
    genome_index = bwa_index(reference)

    # samtools faidx writes the .fai beside the FASTA, where bcftools looks
    # for it: beside the source, in the dataset.
    operation faidx(fasta: Fasta) -> Fai +.fai beside fasta
    command faidx: samtools faidx {fasta}
    genome_fai = faidx(reference)

stage reads:
    # fastp trims adapters and low-quality ends, and reports what it did.
    operation trim(r1: Fastq, r2: Fastq) -> (t1: Fastq .fastq.gz @check(fastq_ok), t2: Fastq .fastq.gz @check(fastq_ok), report: Json .json)
    command trim: fastp --thread {@cores} -i {r1} -I {r2} -o {t1} -O {t2} --json {report} --html /dev/null
    resources trim: cores=2, memory=2G
    trimmed_r1, trimmed_r2, fastp_report = trim(r1, r2)

stage align:
    operation align(index: BwaIndex, r1: Fastq, r2: Fastq) -> Sam .sam
    # The read group names the sample, which bcftools takes as its name.
    command align: bwa mem -M -t {@cores} -R "@RG\tID:{sample}\tSM:{sample}" -o {@output} {index}/genome {r1} {r2}
    resources align: cores=2, memory=1G
    aligned = align(genome_index, trimmed_r1, trimmed_r2)

    # samtools index writes the .bai beside the BAM it indexes.
    operation sort(sam: Sam) -> (bam: Bam .bam @check(bam_ok), bai: Bai +.bai beside bam)
    command sort:
        samtools sort --threads {@cores} -o {bam} {sam}
        samtools index {bam}
    resources sort: cores=2, memory=1G
    sorted, sorted_bai = sort(aligned)

    operation flagstat(bam: Bam) -> Stats .txt
    command flagstat: samtools flagstat {bam} > {@output}
    flags = flagstat(sorted)

stage call:
    # Taking the .fai as an input makes each pileup wait for it, though
    # bcftools finds it beside the FASTA by itself.
    operation pileup(fasta: Fasta, fai: Fai, bam: Bam) -> Bcf .bcf
    command pileup: bcftools mpileup -f {fasta} -O b -o {@output} {bam}
    pileups = pileup(reference, genome_fai, sorted)

    operation call(pileup: Bcf) -> (vcf: Vcf .vcf.gz, csi: Csi +.csi beside vcf)
    command call:
        bcftools call -mv --ploidy 1 -O z -o {vcf} {pileup}
        bcftools index {vcf}
    calls, calls_index = call(pileups)

    operation merge(vcfs: many Vcf) -> Vcf .vcf.gz
    command merge: bcftools merge -O z -o {@output} {vcfs}
    cohort = merge(calls @vary(sample))
