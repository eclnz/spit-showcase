# Spoken digits: clean each recording, measure it, draw it, and summarise
# the recordings per speaker and per digit.

source recording : Wav .wav [speaker, digit, take]

default entities: {@key}={@value} separated "_"
default path: out/{@stage}/{@product}/{@entities}

check nonempty: test -s {@path}
default check: nonempty

# A WAV header alone passes nonempty, so a recording the trim cut away whole
# would flow on as silence.
check audible: sh -c 'test "$(soxi -s "$1")" -gt 0 || { echo "$1 has no audio left"; exit 1; }' sh {@path}

stage clean:
    # Bring every take to 16 kHz at -1 dBFS, then cut the silence at both ends.
    # Normalising first sets the 1% threshold against each take's own peak, so
    # a quiet speaker's take isn't cut away whole.
    operation normalise(audio: Wav) -> Wav .wav
    command normalise: sox -R {audio} {@output} rate 16k norm -1
    normalised = normalise(recording)

    operation trim(audio: Wav) -> Wav .wav @check(audible)
    command trim: sox {audio} {@output} silence 1 0.02 1% reverse silence 1 0.02 1% reverse
    clean = trim(normalised)

stage measure:
    # soxi prints the duration in seconds on its stdout.
    operation duration(audio: Wav) -> Seconds .txt
    command duration: soxi -D {audio} > {@output}
    seconds = duration(clean)

    operation spectrogram(audio: Wav) -> Png .png
    command spectrogram: sox {audio} -n spectrogram -o {@output}
    picture = spectrogram(clean)

stage summarise:
    # Every take of a digit by one speaker, one after another.
    operation concatenate(takes: many Wav) -> Wav .wav
    command concatenate: sox {takes} {@output}
    takes = concatenate(clean @vary(take))

    # A table of durations, one row per file. `{durations.digit}` gives each
    # file's digit, in the order `{durations}` gives the files.
    # Commands run from the dataset root, `data`, so the script is two folders up.
    operation table(durations: many Seconds) -> Table .tsv
    command table: python3 ../../scripts/table.py --speaker {durations.speaker} --digit {durations.digit} --take {durations.take} --seconds {durations} > {@output}
    by_speaker = table(seconds @vary(digit, take))
    by_digit = table(seconds @vary(speaker, take))
